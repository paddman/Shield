[Unit]
Description=NT Shield Brain anomaly and analyst service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntshield
Group=ntshield
WorkingDirectory=/opt/ntshield/ai-service
ExecStart=/opt/ntshield/ai-service/.venv/bin/python /opt/ntshield/ai-service/run_brain.py
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
Environment=PYTHONUNBUFFERED=1
Environment=NTSHIELD_ENVIRONMENT=production
Environment=NTSHIELD_ALLOW_DEV_TENANT=false
Environment=NTSHIELD_LLM_ENABLED=false
Environment=NTSHIELD_DATA_DIR=/var/lib/ntshield/ai
Environment=NTSHIELD_DATABASE_PATH=/var/lib/ntshield/ai/ntshield-brain.db
EnvironmentFile=-/etc/ntshield/ai.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=ntshield/ai
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
