{
  "Kestrel": {
    "Port": 7443,
    "ListenAddress": "127.0.0.1"
  },
  "Security": {
    "EnableMtls": false,
    "RequireAuth": true,
    "EnrollmentToken": "",
    "OperatorApiKey": "",
    "AutoGenerateSecretsOnBoot": true,
    "SecretsFilePath": "/var/lib/ntshield/central/secrets.json",
    "CertificatePath": "/var/lib/ntshield/central/certs/central.pfx",
    "CertificatePassword": "CHANGE_ME",
    "CertificateExtraSans": "127.0.0.1,localhost",
    "PublicHost": "yaksaonline.com",
    "RegenerateCertificate": false,
    "RequireSignedAgent": false
  },
  "ClickHouse": {
    "ConnectionString": "Host=127.0.0.1;Port=8123;Database=default;Username=default;Password=CHANGE_ME",
    "Database": "ntshield",
    "FailWrites": true
  },
  "Database": {
    "Provider": "ClickHouse"
  },
  "Sqlite": {
    "DatabasePath": "/var/lib/ntshield/central/central.db"
  },
  "Syslog": {
    "Enabled": true,
    "UdpPort": 5514,
    "TcpPort": 0,
    "MatchOpenSourceSignatures": true,
    "SignaturesPath": "/opt/ntshield/central/signatures/opensource-signatures.json"
  },
  "Correlation": {
    "TimestampToleranceSeconds": 120
  },
  "LoggingPaths": {
    "Directory": "/var/log/ntshield/central"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
