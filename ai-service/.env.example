NTSHIELD_ENVIRONMENT=development
NTSHIELD_HOST=0.0.0.0
NTSHIELD_PORT=8088
NTSHIELD_DATABASE_PATH=/data/ntshield-brain.db
NTSHIELD_PLAYBOOK_DIR=/app/playbooks

# Local Qwen through an OpenAI-compatible endpoint (vLLM/SGLang/Ollama gateway)
NTSHIELD_LLM_ENABLED=true
NTSHIELD_LLM_BASE_URL=http://host.docker.internal:8000/v1
NTSHIELD_LLM_API_KEY=local
NTSHIELD_LLM_MODEL=qwen3.5:9b
NTSHIELD_LLM_ENABLE_THINKING=false
NTSHIELD_ANALYSIS_MODE=multi_agent

# To route through Central instead of contacting the model server directly:
# NTSHIELD_LLM_BASE_URL=https://<CENTRAL>:7443/api/v1/llm/v1
# NTSHIELD_LLM_API_KEY=ntllm_<issued-token-from-control-center>
# NTSHIELD_LLM_MODEL=qwen3.5:9b

# NTShield AV source-code second-pass limits
NTSHIELD_CODE_SCAN_MAX_LLM_FINDINGS=80
NTSHIELD_CODE_SCAN_MAX_LLM_CHARS=60000
NTSHIELD_CODE_SCAN_LLM_MAX_TOKENS=2800

# One or more tenant objects. Hash the key with SHA-256 and use api_key_sha256 in production.
# Cross-tenant IOC publication additionally requires metadata.can_publish_intel=true or an operator/SOC role.
NTSHIELD_TENANTS_JSON=[{"tenant_id":"demo","name":"NT Shield Demo","api_key":"change-me","central_url":"https://host.docker.internal:7443","central_api_key":"replace-with-operator-key","central_verify_tls":false,"metadata":{"role":"operator","principal":"demo-soc","can_publish_intel":true}}]
NTSHIELD_ALLOW_DEV_TENANT=false

# Add the production dashboard origin at deployment time. Do not commit customer or live public IPs.
NTSHIELD_CORS_ORIGINS=http://203.0.113.10:10118
