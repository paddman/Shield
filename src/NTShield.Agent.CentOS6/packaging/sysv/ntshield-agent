#!/bin/bash
# chkconfig: 2345 95 05
# description: NT Shield CentOS 6 traffic, syslog and WAF telemetry agent
# processname: ntshield-agent
# pidfile: /var/run/ntshield-agent.pid

DAEMON=/opt/ntshield/centos6-agent/ntshield-agent
CONFIG=/etc/ntshield-agent/config.json
PIDFILE=/var/run/ntshield-agent.pid
LOCKFILE=/var/lock/subsys/ntshield-agent
SERVICE=ntshield-agent

[ -r /etc/sysconfig/ntshield-agent ] && . /etc/sysconfig/ntshield-agent
[ -r /etc/init.d/functions ] && . /etc/init.d/functions

is_running() {
    [ -r "$PIDFILE" ] || return 1
    pid="$(cat "$PIDFILE" 2>/dev/null)"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    return 0
}

start() {
    echo -n "Starting $SERVICE: "
    if is_running; then
        echo "already running"
        return 0
    fi
    [ -x "$DAEMON" ] || { echo "binary missing: $DAEMON"; return 5; }
    [ -r "$CONFIG" ] || { echo "config missing: $CONFIG"; return 6; }

    ulimit -n 65536 2>/dev/null || true
    cd / || return 1
    nohup "$DAEMON" -config "$CONFIG" </dev/null >/dev/null 2>&1 &
    pid=$!
    echo "$pid" > "$PIDFILE"
    sleep 1
    if kill -0 "$pid" 2>/dev/null; then
        touch "$LOCKFILE"
        command -v success >/dev/null 2>&1 && success || echo -n "OK"
        echo
        return 0
    fi
    rm -f "$PIDFILE" "$LOCKFILE"
    command -v failure >/dev/null 2>&1 && failure || echo -n "FAILED"
    echo
    return 1
}

stop() {
    echo -n "Stopping $SERVICE: "
    if ! is_running; then
        rm -f "$PIDFILE" "$LOCKFILE"
        echo "not running"
        return 0
    fi
    pid="$(cat "$PIDFILE")"
    kill -TERM "$pid" 2>/dev/null || true
    i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 30 ]; do
        sleep 1
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
        sleep 1
    fi
    rm -f "$PIDFILE" "$LOCKFILE"
    command -v success >/dev/null 2>&1 && success || echo -n "OK"
    echo
}

status_agent() {
    if is_running; then
        echo "$SERVICE is running (pid $(cat "$PIDFILE"))"
        return 0
    fi
    echo "$SERVICE is stopped"
    return 3
}

case "${1:-}" in
    start) start ;;
    stop) stop ;;
    restart|force-reload) stop; start ;;
    status) status_agent ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 2 ;;
esac
exit $?
