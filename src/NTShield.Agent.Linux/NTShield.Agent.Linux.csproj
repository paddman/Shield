<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NTShield.Agent.Linux</RootNamespace>
    <AssemblyName>NTShield.Agent.Linux</AssemblyName>
    <Description>NT Shield Linux Agent — metrics, multi-stack logs (nginx/PHP/Docker/Node), allowlisted remediation</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NTShield.Shared\NTShield.Shared.csproj" />
    <ProjectReference Include="..\NTShield.Transport\NTShield.Transport.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="ntshield-agent.service" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
