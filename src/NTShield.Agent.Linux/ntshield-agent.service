[Unit]
Description=NT Shield Linux Agent
Documentation=https://github.com/paddman/Shield
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/opt/ntshield/agent/NTShield.Agent.Linux
WorkingDirectory=/opt/ntshield/agent
Restart=on-failure
RestartSec=5
TimeoutStartSec=30
Environment=DOTNET_ENVIRONMENT=Production

# Fail-closed service sandbox. Response actions remain allowlisted in-process;
# the service receives no arbitrary shell endpoint.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/opt/ntshield /var/log/ntshield /var/lib/ntshield
UMask=0077

[Install]
WantedBy=multi-user.target
