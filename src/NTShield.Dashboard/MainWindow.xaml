<Window x:Class="NTShield.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NT Shield Dashboard"
        Width="1540" Height="900" MinWidth="1250" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="260"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="360"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Sidebar -->
    <Border Grid.RowSpan="2" Grid.Column="0">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#171C26"/>
          <GradientStop Color="#111722" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="72"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
          <Border Width="40" Height="40" CornerRadius="10" ClipToBounds="True">
            <Image Source="Assets/app-icon-master.png" Stretch="UniformToFill"/>
          </Border>
          <TextBlock Text="NT Shield Agent" Foreground="White" FontSize="16" FontWeight="Bold"
                     Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,8">
          <Button x:Name="NavDashboard" Style="{StaticResource SideButton}" Background="#B37A00" Click="Nav_Click" Tag="Dashboard">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▦" Foreground="White" FontSize="20" Width="34"/>
              <TextBlock Text="Dashboard" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavIncidents" Style="{StaticResource SideButton}" Click="Nav_Click" Tag="Incidents">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚠" Foreground="White" FontSize="20" Width="34"/>
              <TextBlock Text="Incidents" Foreground="White" VerticalAlignment="Center"/>
              <Border Background="#3B465A" CornerRadius="12" Padding="8,2" Margin="12,0,0,0">
                <TextBlock x:Name="IncidentBadge" Text="0" Foreground="White"/>
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="NavPaths" Style="{StaticResource SideButton}" Click="Nav_Click" Tag="Paths">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⇄" Foreground="White" FontSize="20" Width="34"/>
              <TextBlock Text="Lateral Paths" Foreground="White"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavEndpoints" Style="{StaticResource SideButton}" Click="Nav_Click" Tag="Agents">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▣" Foreground="White" FontSize="20" Width="34"/>
              <TextBlock Text="Endpoints" Foreground="White"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavRules" Style="{StaticResource SideButton}" Click="Nav_Click" Tag="Catalog">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▤" Foreground="White" FontSize="20" Width="34"/>
              <TextBlock Text="Rules" Foreground="White"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavFirewall" Style="{StaticResource SideButton}" Click="Nav_Click" Tag="Firewall">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="🔥" Foreground="White" FontSize="20" Width="34"/>
              <TextBlock Text="Firewall" Foreground="White"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavServices" Style="{StaticResource SideButton}" Click="Nav_Click" Tag="Services">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="▶" Foreground="White" FontSize="20" Width="34"/>
              <TextBlock Text="Services" Foreground="White"/>
            </StackPanel>
          </Button>
          <Button x:Name="NavSettings" Style="{StaticResource SideButton}" Click="Nav_Click" Tag="Settings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="⚙" Foreground="White" FontSize="20" Width="34"/>
              <TextBlock Text="Settings" Foreground="White"/>
            </StackPanel>
          </Button>
        </StackPanel>
        <Border Grid.Row="2" Background="#252D3B" CornerRadius="10" Margin="14" Padding="14">
          <StackPanel>
            <TextBlock Text="🛡  Agent Status" Foreground="White" FontWeight="SemiBold"/>
            <TextBlock x:Name="SidebarStatusText" Text="Healthy" Foreground="#35D880" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/>
            <TextBlock x:Name="SidebarCheckinText" Text="Last check-in: —" Foreground="#D8E4F7" Margin="0,5,0,0"/>
            <TextBlock x:Name="SidebarVersionText" Text="Dashboard v—" Foreground="#8298B8" Margin="0,14,0,0"/>
            <TextBlock x:Name="SidebarCentralVersionText" Text="Central v—" Foreground="#8298B8" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Header -->
    <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Background="White"
            BorderBrush="#E4EAF3" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="Header_MouseLeftButtonDown">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="🛡" FontSize="26"/>
          <StackPanel Margin="10,0">
            <TextBlock x:Name="ProtectedTitle" Text="Protected" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="ProtectedSub" Text="All systems operational" Foreground="#73809A" FontSize="12"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBox x:Name="ServerUrlBox" Width="220" Text="https://localhost:7443" Padding="8,5"
                   Margin="0,0,8,0" VerticalAlignment="Center" BorderBrush="#DCE5F2"/>
          <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Click="RefreshBtn_Click" Padding="12,8" Margin="0,0,8,0"/>
          <Button Content="—" Click="Minimize_Click" Background="Transparent" BorderThickness="0" Padding="12"/>
          <Button Content="□" Click="Maximize_Click" Background="Transparent" BorderThickness="0" Padding="12"/>
          <Button Content="×" Click="Close_Click" Background="Transparent" BorderThickness="0" Padding="12"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main -->
    <Grid Grid.Column="1" Grid.Row="1">
      <!-- Dashboard -->
      <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16,14,10,16">
          <DockPanel Margin="6,0,6,8">
            <TextBlock Text="Threat Overview" FontWeight="Bold" FontSize="19"/>
            <TextBlock x:Name="ModeLabel" Text="Live only — no mock data" Foreground="#6C7892" DockPanel.Dock="Right" VerticalAlignment="Center"/>
          </DockPanel>
          <UniformGrid Columns="4">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Active Incidents"/>
                <TextBlock x:Name="KpiIncidents" Text="0" Foreground="#F04444" FontSize="27" FontWeight="Bold"/>
                <TextBlock x:Name="KpiIncidentsHint" Text="open" Foreground="#F04444" FontSize="11"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Threat Campaigns"/>
                <TextBlock x:Name="KpiCampaigns" Text="0" Foreground="#B37A00" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="cross-host" Foreground="#18B86B" FontSize="11"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Multi-hop Paths"/>
                <TextBlock x:Name="KpiMultiHop" Text="0" Foreground="#FF9F1A" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="lateral chains" Foreground="#FF9F1A" FontSize="11"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Protected Endpoints"/>
                <TextBlock x:Name="KpiAgents" Text="0" Foreground="#18B86B" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="agents online" Foreground="#18B86B" FontSize="11"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.05*"/>
              <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="Active Incidents" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="View all" Foreground="#B37A00" DockPanel.Dock="Right" Cursor="Hand" MouseLeftButtonUp="ViewAllIncidents_Click"/>
                </DockPanel>
                <DataGrid x:Name="OverviewIncidentsGrid" Margin="0,10,0,0" MaxHeight="240"
                          SelectionChanged="IncidentsGrid_SelectionChanged" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Sev" Binding="{Binding Severity}" Width="70"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/>
                    <DataGridTextColumn Header="Route" Binding="{Binding Route}" Width="160"/>
                    <DataGridTextColumn Header="Failed" Binding="{Binding FailedAttempts}" Width="60"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
              <StackPanel>
                <DockPanel>
                  <TextBlock Text="Failed Login Spikes" FontWeight="Bold" FontSize="15"/>
                  <TextBlock Text="Last 24 hours" Foreground="#6C7892" DockPanel.Dock="Right"/>
                </DockPanel>
                <Grid Height="190" Margin="10,8,10,0">
                  <Border BorderBrush="#D8E3F0" BorderThickness="1" CornerRadius="8" Background="#FAFCFF">
                    <Grid>
                      <TextBlock x:Name="FailedLoginEmptyHint"
                                 Text="No failed-login spike data yet (live only)"
                                 Foreground="#6C7892" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <Canvas x:Name="FailedLoginCanvas" Margin="8" Visibility="Collapsed">
                        <Line X1="30" Y1="10" X2="30" Y2="150" Stroke="#D8E3F0"/>
                        <Line X1="30" Y1="150" X2="380" Y2="150" Stroke="#D8E3F0"/>
                        <Polyline x:Name="FailedLoginLine" Stroke="#B37A00" StrokeThickness="3" Points=""/>
                        <Polygon x:Name="FailedLoginFill" Fill="#22FFC400" Points=""/>
                        <Border x:Name="FailedLoginPeakBadge" Canvas.Left="320" Canvas.Top="12"
                                Background="#B37A00" CornerRadius="5" Padding="7,3" Visibility="Collapsed">
                          <TextBlock x:Name="FailedLoginPeak" Text="0" Foreground="White"/>
                        </Border>
                      </Canvas>
                    </Grid>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <UniformGrid Columns="4">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Password Spray Detection" FontWeight="Bold"/>
                <Grid Height="130">
                  <Ellipse Width="92" Height="92" Stroke="#F04444" StrokeThickness="13"/>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="SprayUsersText" Text="0" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Users" FontSize="11" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Top Source IPs" FontWeight="Bold"/>
                <ItemsControl x:Name="TopSourcesList" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,4" FontSize="12">
                        <Run Text="{Binding Key}"/><Run Text="  "/><Run Text="{Binding Value}" FontWeight="SemiBold"/>
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Top Destination Hosts" FontWeight="Bold"/>
                <ItemsControl x:Name="TopDestList" Margin="0,12,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Margin="0,4" FontSize="12">
                        <Run Text="{Binding Key}"/><Run Text="  "/><Run Text="{Binding Value}" FontWeight="SemiBold"/>
                      </TextBlock>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Process / Service Correlation" FontWeight="Bold"/>
                <Grid Height="130">
                  <Ellipse Width="92" Height="92" Stroke="#B37A00" StrokeThickness="13"/>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ProcessEventsText" Text="0" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Events" FontSize="11" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="Recent Response Actions" FontWeight="Bold" FontSize="15"/>
                <TextBlock Text="Detect-only by default" Foreground="#6C7892" DockPanel.Dock="Right"/>
              </DockPanel>
              <DataGrid x:Name="ActionsGrid" Margin="0,10,0,0" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100"/>
                  <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180"/>
                  <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="150"/>
                  <DataGridTextColumn Header="Triggered By" Binding="{Binding TriggeredBy}" Width="*"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>


      <!-- Incidents page -->
      <Border x:Name="PageIncidents" Visibility="Collapsed" Margin="12" Style="{StaticResource Card}">
        <DataGrid x:Name="IncidentsGrid" SelectionChanged="IncidentsGrid_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/>
            <DataGridTextColumn Header="Source" Binding="{Binding SourceIp}" Width="120"/>
            <DataGridTextColumn Header="Destination" Binding="{Binding DestinationIp}" Width="120"/>
            <DataGridTextColumn Header="Port" Binding="{Binding DestinationPort}" Width="60"/>
            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="120"/>
            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="70"/>
            <DataGridTextColumn Header="Failed" Binding="{Binding FailedAttempts}" Width="70"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Paths -->
      <Grid x:Name="PagePaths" Visibility="Collapsed" Margin="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Threat Campaigns" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListBox x:Name="CampaignsList" BorderThickness="0" SelectionChanged="CampaignsList_SelectionChanged"/>
          </DockPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0">
          <ScrollViewer>
            <StackPanel>
              <TextBlock x:Name="PathVisualText" FontFamily="Consolas" FontSize="13" Foreground="#B45309" TextWrapping="Wrap" Margin="0,0,0,12"/>
              <TextBlock x:Name="CampaignDetailText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
            </StackPanel>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- Agents — fleet + rich detail -->
      <Grid x:Name="PageAgents" Visibility="Collapsed" Margin="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Fleet KPI strip -->
        <UniformGrid x:Name="AgentsKpiStrip" Rows="1" Columns="5" Margin="0,0,0,10">
          <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14,12">
            <StackPanel>
              <TextBlock Text="FLEET" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="AgKpiTotal" Text="0" FontSize="26" FontWeight="Bold"/>
              <TextBlock Text="endpoints" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14,12">
            <StackPanel>
              <TextBlock Text="ONLINE" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="AgKpiOnline" Text="0" FontSize="26" FontWeight="Bold" Foreground="#059669"/>
              <TextBlock x:Name="AgKpiOffline" Text="0 offline" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14,12">
            <StackPanel>
              <TextBlock Text="WINDOWS" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="AgKpiWin" Text="0" FontSize="26" FontWeight="Bold" Foreground="#B37A00"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="14,12">
            <StackPanel>
              <TextBlock Text="LINUX" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="AgKpiLinux" Text="0" FontSize="26" FontWeight="Bold" Foreground="#7C3AED"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="14,12">
            <StackPanel>
              <TextBlock Text="AVG CPU / MEM" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
              <TextBlock x:Name="AgKpiAvg" Text="— / —" FontSize="20" FontWeight="Bold"/>
              <TextBlock Text="online hosts with metrics" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="1.35*"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="0">
            <DockPanel>
              <Border DockPanel.Dock="Top" Background="#0B1220" Padding="14,12" CornerRadius="10,10,0,0">
                <DockPanel>
                  <TextBlock Text="Endpoint Fleet" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                  <TextBlock x:Name="AgentsFleetHint" DockPanel.Dock="Right" Foreground="#94A3B8" FontSize="11"
                             Text="Select a host →" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </DockPanel>
              </Border>
              <DataGrid x:Name="AgentsGrid" BorderThickness="0" SelectionChanged="AgentsGrid_SelectionChanged"
                        HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        AlternatingRowBackground="#F8FAFC" RowBackground="White"
                        AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="●" Binding="{Binding OnlineGlyph}" Width="36"/>
                  <DataGridTextColumn Header="Host" Binding="{Binding ComputerName}" Width="120"/>
                  <DataGridTextColumn Header="IP" Binding="{Binding HostIp}" Width="100"/>
                  <DataGridTextColumn Header="OS" Binding="{Binding Platform}" Width="60"/>
                  <DataGridTextColumn Header="CPU" Binding="{Binding CpuText}" Width="55"/>
                  <DataGridTextColumn Header="MEM" Binding="{Binding MemText}" Width="55"/>
                  <DataGridTextColumn Header="DISK" Binding="{Binding DiskText}" Width="55"/>
                  <DataGridTextColumn Header="Ver" Binding="{Binding Version}" Width="70"/>
                  <DataGridTextColumn Header="Status" Binding="{Binding StatusShort}" Width="*"/>
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </Border>

          <!-- Detail panel -->
          <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Background="#0B1220">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18">
              <StackPanel>
                <DockPanel Margin="0,0,0,6">
                  <StackPanel>
                    <TextBlock x:Name="AgDetailHost" Text="Select an agent" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="AgDetailSub" Text="Live inventory from Central heartbeats" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Border x:Name="AgDetailOnlineBadge" DockPanel.Dock="Right" Background="#064E3B" CornerRadius="12" Padding="12,6" VerticalAlignment="Top" Margin="8,0,0,0">
                    <TextBlock x:Name="AgDetailOnlineText" Text="—" Foreground="#6EE7B7" FontWeight="SemiBold" FontSize="12"/>
                  </Border>
                </DockPanel>

                <!-- Metric tiles -->
                <UniformGrid Columns="4" Margin="0,12,0,8">
                  <Border Background="#111827" CornerRadius="10" Margin="0,0,8,8" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="CPU" Foreground="#94A3B8" FontSize="10"/>
                      <TextBlock x:Name="AgTileCpu" Text="—" Foreground="#38BDF8" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#111827" CornerRadius="10" Margin="0,0,8,8" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="MEMORY" Foreground="#94A3B8" FontSize="10"/>
                      <TextBlock x:Name="AgTileMem" Text="—" Foreground="#A78BFA" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#111827" CornerRadius="10" Margin="0,0,8,8" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="DISK" Foreground="#94A3B8" FontSize="10"/>
                      <TextBlock x:Name="AgTileDisk" Text="—" Foreground="#FBBF24" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#111827" CornerRadius="10" Margin="0,0,0,8" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="LOAD / QUEUE" Foreground="#94A3B8" FontSize="10"/>
                      <TextBlock x:Name="AgTileLoad" Text="—" Foreground="#34D399" FontSize="18" FontWeight="Bold"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
                <UniformGrid Columns="4" Margin="0,0,0,12">
                  <Border Background="#111827" CornerRadius="10" Margin="0,0,8,0" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="NET RX" Foreground="#94A3B8" FontSize="10"/>
                      <TextBlock x:Name="AgTileNetRx" Text="—" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#111827" CornerRadius="10" Margin="0,0,8,0" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="NET TX" Foreground="#94A3B8" FontSize="10"/>
                      <TextBlock x:Name="AgTileNetTx" Text="—" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#111827" CornerRadius="10" Margin="0,0,8,0" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="DISK I/O R·W" Foreground="#94A3B8" FontSize="10"/>
                      <TextBlock x:Name="AgTileIo" Text="—" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                  <Border Background="#111827" CornerRadius="10" Padding="12,10">
                    <StackPanel>
                      <TextBlock Text="AGENT RAM" Foreground="#94A3B8" FontSize="10"/>
                      <TextBlock x:Name="AgTileWs" Text="—" Foreground="#E2E8F0" FontSize="14" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <!-- CPU history chart -->
                <TextBlock Text="CPU HISTORY (heartbeat samples)" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,6"/>
                <Border Background="#111827" CornerRadius="10" Height="90" Margin="0,0,0,14" ClipToBounds="True">
                  <Canvas x:Name="AgCpuChart" Margin="8,8,8,8"/>
                </Border>

                <TextBlock Text="IDENTITY &amp; HEALTH" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="#111827" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="AgDetailIdentity" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Text="—"/>
                  </StackPanel>
                </Border>

                <TextBlock Text="INTEGRITY · POLICY · CENTRAL" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="#111827" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="AgDetailIntegrity" Foreground="#CBD5E1" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Text="—"/>
                  </StackPanel>
                </Border>

                <TextBlock Text="STATUS / METRICS LINE" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="#111827" CornerRadius="10" Padding="14" Margin="0,0,0,8">
                  <TextBlock x:Name="AgDetailMetricsLine" Foreground="#7DD3FC" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Text="—"/>
                </Border>
                <TextBlock x:Name="AgDetailError" Foreground="#FCA5A5" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>

                <TextBlock Text="SERVICE CONTROL (this host)" Foreground="#64748B" FontSize="10" FontWeight="SemiBold" Margin="12,8,0,6"/>
                <Border Background="#111827" CornerRadius="10" Padding="12" Margin="0,0,0,4">
                  <StackPanel>
                    <TextBox x:Name="AgSvcNameBox" Padding="8" Margin="0,0,0,8" Background="#1F2937" Foreground="White"
                             BorderBrush="#374151" CaretBrush="White" FontFamily="Consolas"
                             ToolTip="Windows service short name or Linux unit"/>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Start" Padding="12,6" Margin="0,0,8,0" Click="AgSvcStart_Click"/>
                      <Button Content="Stop" Padding="12,6" Margin="0,0,8,0" Click="AgSvcStop_Click"/>
                      <Button Content="Restart" Padding="12,6" Click="AgSvcRestart_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="AgSvcStatusText" Foreground="#94A3B8" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <!-- Catalog -->
      <Border x:Name="PageCatalog" Visibility="Collapsed" Margin="12" Style="{StaticResource Card}">
        <DataGrid x:Name="CatalogGrid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="140"/>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
            <DataGridTextColumn Header="Rule ID" Binding="{Binding DetectionRuleId}" Width="220"/>
            <DataGridTextColumn Header="MITRE" Binding="{Binding MitreTechnique}" Width="100"/>
            <DataGridTextColumn Header="Cross-host" Binding="{Binding CrossHostTracking}" Width="*"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>

      <!-- Firewall control (live actions via Central → Agent) -->
      <Border x:Name="PageFirewall" Visibility="Collapsed" Margin="12" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Firewall Control" FontWeight="Bold" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock Text="Orders go to Central → Agent executes with Windows Firewall (netsh). Requires operator confirm."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <TextBlock Text="Target Agent" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="FwAgentBox" Height="34" Margin="0,0,0,12" DisplayMemberPath="Display"/>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Block IP -->
              <Border Grid.Column="0" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="8" Padding="12" Background="#FAFCFF">
                <StackPanel>
                  <TextBlock Text="Block IP" FontWeight="Bold" Margin="0,0,0,8"/>
                  <TextBlock Text="Source IP (inbound block)" Foreground="#6C7892" FontSize="11"/>
                  <TextBox x:Name="FwSourceIpBox" Padding="8" Margin="0,0,0,8" ToolTip="e.g. attacker IP"/>
                  <TextBlock Text="Destination IP (outbound block)" Foreground="#6C7892" FontSize="11"/>
                  <TextBox x:Name="FwDestIpBox" Padding="8" Margin="0,0,0,8" ToolTip="e.g. C2 server"/>
                  <TextBlock Text="Reason" Foreground="#6C7892" FontSize="11"/>
                  <TextBox x:Name="FwIpReasonBox" Padding="8" Margin="0,0,0,10" Text="Operator block from Dashboard"/>
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Block Source IP" Style="{StaticResource PrimaryButton}" Click="FwBlockSource_Click" Margin="0,0,8,0" Padding="12,8"/>
                    <Button Content="Block Dest IP" Style="{StaticResource PrimaryButton}" Click="FwBlockDest_Click" Padding="12,8"/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- Port open/close/block -->
              <Border Grid.Column="2" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="8" Padding="12" Background="#FAFCFF">
                <StackPanel>
                  <TextBlock Text="Port open / close / block" FontWeight="Bold" Margin="0,0,0,8"/>
                  <TextBlock Text="Port" Foreground="#6C7892" FontSize="11"/>
                  <TextBox x:Name="FwPortBox" Padding="8" Margin="0,0,0,8" Text="445"/>
                  <TextBlock Text="Protocol" Foreground="#6C7892" FontSize="11"/>
                  <ComboBox x:Name="FwProtoBox" Height="32" Margin="0,0,0,8" SelectedIndex="0">
                    <ComboBoxItem Content="tcp"/>
                    <ComboBoxItem Content="udp"/>
                    <ComboBoxItem Content="any"/>
                  </ComboBox>
                  <TextBlock Text="Direction" Foreground="#6C7892" FontSize="11"/>
                  <ComboBox x:Name="FwDirBox" Height="32" Margin="0,0,0,8" SelectedIndex="0">
                    <ComboBoxItem Content="in"/>
                    <ComboBoxItem Content="out"/>
                  </ComboBox>
                  <TextBlock Text="Optional remote IP (for Block Port)" Foreground="#6C7892" FontSize="11"/>
                  <TextBox x:Name="FwPortRemoteIpBox" Padding="8" Margin="0,0,0,8"/>
                  <TextBlock Text="Rule name (for Close) NTS-..." Foreground="#6C7892" FontSize="11"/>
                  <TextBox x:Name="FwRuleNameBox" Padding="8" Margin="0,0,0,10" ToolTip="Required to close/remove a rule"/>
                  <WrapPanel>
                    <Button Content="Open Port (allow)" Style="{StaticResource PrimaryButton}" Click="FwOpenPort_Click" Margin="0,0,8,8" Padding="12,8"/>
                    <Button Content="Block Port" Style="{StaticResource PrimaryButton}" Click="FwBlockPort_Click" Margin="0,0,8,8" Padding="12,8"/>
                    <Button Content="Close / Remove Rule" Style="{StaticResource OutlineButton}" Click="FwClosePort_Click" Margin="0,0,0,8" Padding="12,8"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </Grid>

            <TextBlock x:Name="FwStatusText" Margin="0,14,0,6" TextWrapping="Wrap"
                       Text="Select an agent, fill IP/port, then confirm. Agent applies netsh on next heartbeat (~60s or less)."/>
            <TextBlock Text="Recent actions from this session" FontWeight="SemiBold" Margin="0,8,0,6"/>
            <DataGrid x:Name="FwActionsGrid" Height="180" HeadersVisibility="Column" IsReadOnly="True"
                      AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="140"/>
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="160"/>
                <DataGridTextColumn Header="Agent" Binding="{Binding TriggeredBy}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Services start/stop/restart via Central → Agent -->
      <Border x:Name="PageServices" Visibility="Collapsed" Margin="12" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Service Control" FontWeight="Bold" FontSize="18" Margin="0,0,0,4"/>
            <TextBlock Text="Start / Stop / Restart Windows service or Linux systemd unit on a remote agent. Queued via Central, applied on next heartbeat."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

            <TextBlock Text="Target Agent" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox x:Name="SvcAgentBox" Height="34" Margin="0,0,0,12" DisplayMemberPath="Display"/>

            <Border BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="10" Padding="16" Background="#FAFCFF" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Service / unit name" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Windows: short service name (e.g. W3SVC, Spooler, MySQL80) · Linux: nginx, php8.3-fpm, docker"
                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <TextBox x:Name="SvcNameBox" Padding="10" Margin="0,0,0,10" FontFamily="Consolas"
                         ToolTip="Service name as used by sc.exe / systemctl"/>

                <TextBlock Text="Reason (audit)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="SvcReasonBox" Padding="10" Margin="0,0,0,14" Text="Operator service control from Dashboard"/>

                <TextBlock Text="Quick picks" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,6"/>
                <WrapPanel Margin="0,0,0,14">
                  <Button Content="W3SVC (IIS)" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Padding="10,6" Click="SvcQuick_Click" Tag="W3SVC"/>
                  <Button Content="WAS" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Padding="10,6" Click="SvcQuick_Click" Tag="WAS"/>
                  <Button Content="Spooler" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Padding="10,6" Click="SvcQuick_Click" Tag="Spooler"/>
                  <Button Content="MSSQLSERVER" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Padding="10,6" Click="SvcQuick_Click" Tag="MSSQLSERVER"/>
                  <Button Content="nginx" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Padding="10,6" Click="SvcQuick_Click" Tag="nginx"/>
                  <Button Content="php-fpm" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Padding="10,6" Click="SvcQuick_Click" Tag="php-fpm"/>
                  <Button Content="docker" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Padding="10,6" Click="SvcQuick_Click" Tag="docker"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal">
                  <Button Content="▶ Start" Style="{StaticResource PrimaryButton}" Click="SvcStart_Click" Margin="0,0,10,0" Padding="18,10"/>
                  <Button Content="■ Stop" Style="{StaticResource OutlineButton}" Click="SvcStop_Click" Margin="0,0,10,0" Padding="18,10"/>
                  <Button Content="↻ Restart" Style="{StaticResource PrimaryButton}" Click="SvcRestart_Click" Padding="18,10"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock x:Name="SvcStatusText" Margin="0,4,0,8" TextWrapping="Wrap"
                       Text="Select agent + service name, then Start / Stop / Restart. Agent applies on next heartbeat (~60s)."/>
            <TextBlock Text="Session actions" FontWeight="SemiBold" Margin="0,4,0,6"/>
            <DataGrid x:Name="SvcActionsGrid" Height="200" HeadersVisibility="Column" IsReadOnly="True"
                      AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="90"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120"/>
                <DataGridTextColumn Header="Service" Binding="{Binding Target}" Width="160"/>
                <DataGridTextColumn Header="Agent" Binding="{Binding TriggeredBy}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Settings -->
      <Border x:Name="PageSettings" Visibility="Collapsed" Margin="12" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="Connection Settings" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
          <TextBlock Text="Central Server URL" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
          <TextBox x:Name="SettingsUrlBox" Text="https://localhost:7443" Padding="10" Margin="0,0,0,12"/>
          <TextBlock Text="Operator API Key (X-NTShield-Api-Key)" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
          <TextBox x:Name="SettingsApiKeyBox" Text="" Padding="10" Margin="0,0,0,6"
                   ToolTip="From Central secrets.json → OperatorApiKey (required when Security:RequireAuth=true)"/>
          <TextBlock Text="Copy OperatorApiKey from C:\ProgramData\NTShield\Server\secrets.json"
                     Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"/>
          <TextBlock x:Name="KpiMode" Text="Mode: —" Margin="0,0,0,6"/>
          <TextBlock x:Name="LastRefreshText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="Apply &amp; Refresh" Style="{StaticResource PrimaryButton}" Click="ApplySettings_Click"/>
          </StackPanel>

          <TextBlock Text="About / Versions" FontWeight="Bold" FontSize="16" Margin="0,28,0,10"/>
          <TextBlock x:Name="AboutDashboardVersion" Text="Dashboard: —" Margin="0,0,0,4"/>
          <TextBlock x:Name="AboutCentralVersion" Text="Central: —" Margin="0,0,0,4"/>
          <TextBlock x:Name="AboutAgentHint" Text="Agent versions: see Endpoints column (per host)"
                     Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

          <TextBlock Text="No mock/demo data is loaded. Empty UI means no live telemetry yet."
                     Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Right rail -->
    <ScrollViewer Grid.Column="2" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F7F9FD">
      <StackPanel Margin="8,8,14,16">
        <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
          <Grid Height="315">
            <Grid.RowDefinitions>
              <RowDefinition Height="42"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Border Background="#B37A00">
              <DockPanel Margin="14,0">
                <TextBlock Text="NT Shield AI Analyst" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <Grid Grid.Row="1" Background="#FFF9E8">
              <Border Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="8"
                      Padding="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Width="200">
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Text="I am the NT Shield AI Analyst.&#10;ฉันช่วยเฝ้าระวัง วิเคราะห์ และตอบสนอง Incident ได้"/>
              </Border>
              <Image Source="Assets/ntshield_full.png" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Height="255" Margin="0,0,-12,-5"/>
            </Grid>
          </Grid>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <DockPanel>
              <TextBlock Text="Incident Detail" FontWeight="Bold" FontSize="16"/>
              <Border x:Name="DetailSeverityBadge" Background="#F04444" CornerRadius="5" Padding="9,3" DockPanel.Dock="Right">
                <TextBlock x:Name="DetailSeverityText" Text="—" Foreground="White"/>
              </Border>
            </DockPanel>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
                <RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Incident"/><TextBlock x:Name="D_Title" Grid.Column="1" FontWeight="SemiBold" Text="—"/>
              <TextBlock Grid.Row="1" Text="Source IP"/><TextBlock x:Name="D_Source" Grid.Row="1" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="2" Text="Destination IP"/><TextBlock x:Name="D_Dest" Grid.Row="2" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="3" Text="Process"/><TextBlock x:Name="D_Process" Grid.Row="3" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="4" Text="Service"/><TextBlock x:Name="D_Service" Grid.Row="4" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="5" Text="Logon Type"/><TextBlock x:Name="D_Logon" Grid.Row="5" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="6" Text="Failed Attempts"/><TextBlock x:Name="D_Failed" Grid.Row="6" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="7" Text="Distinct Users"/><TextBlock x:Name="D_Users" Grid.Row="7" Grid.Column="1" Text="—"/>
              <TextBlock Grid.Row="8" Text="Success Login"/><TextBlock x:Name="D_Success" Grid.Row="8" Grid.Column="1" Text="—"/>
            </Grid>
          </StackPanel>
        </Border>

        <UniformGrid Columns="2">
          <Button Style="{StaticResource PrimaryButton}" Content="⊘  Block Destination" Click="QuickBlockDest_Click"/>
          <Button Style="{StaticResource PrimaryButton}" Content="⊘  Block Source" Click="QuickBlockSource_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="🔥  Firewall Panel" Click="OpenFirewallPanel_Click"/>
          <Button Style="{StaticResource OutlineButton}" Content="⌁  Capture Evidence" Click="Action_Click"/>
        </UniformGrid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
