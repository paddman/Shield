{
  "Agent": {
    "Name": "NT Shield Agent",
    "AgentId": "",
    "ComputerName": "",
    "DataDirectory": "C:\\ProgramData\\NTShield\\Agent",
    "Version": "1.1.0",
    "HeartbeatSeconds": 60,
    "CollectionIntervalSeconds": 5,
    "DetectOnly": true,
    "Mode": "Ids"
  },
  "Collectors": {
    "SecurityEvents": true,
    "NetworkConnections": true,
    "Processes": true,
    "Services": true,
    "ScheduledTasks": true
  },
  "Server": {
    "Url": "https://localhost:7443",
    "EnrollmentToken": "",
    "ApiKey": "",
    "BatchSize": 200,
    "OfflineQueueLimit": 100000,
    "EnableMtls": false,
    "AllowUntrustedServerCertificate": true,
    "TimeoutSeconds": 30,
    "HeartbeatIntervalSeconds": 60,
    "FlushIntervalSeconds": 15,
    "SyslogEnabled": true,
    "SyslogHost": "127.0.0.1",
    "SyslogPort": 5514,
    "SyslogProtocol": "Udp",
    "SyslogAppName": "NTShield"
  },
  "Storage": {
    "DatabaseFileName": "agent.db",
    "RetentionDays": 14,
    "MaxDatabaseSizeMb": 1024,
    "MaintenanceIntervalMinutes": 60,
    "OfflineQueueLimit": 100000
  },
  "Detection": {
    "Enabled": true,
    "RulesPath": "config/rules.json",
    "AllowlistPath": "config/allowlist.json",
    "EvaluationIntervalSeconds": 10,
    "AllowlistUsernames": [],
    "AllowlistSourceIps": []
  },
  "Response": {
    "Enabled": true,
    "Mode": "Ids",
    "DetectOnly": true,
    "LogOnlyMode": true,
    "AllowNetworkIsolation": false,
    "AllowProcessTerminate": false,
    "AutoBlockMinSeverity": "High",
    "AutoBlockSourceIp": true,
    "AutoBlockDestinationIp": true,
    "AutoBlockDestinationPort": false,
    "AutoQuarantineHost": false,
    "EvidenceDirectory": "C:\\ProgramData\\NTShield\\Agent\\evidence"
  },
  "LoggingPaths": {
    "Directory": "C:\\ProgramData\\NTShield\\Agent\\logs"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
