<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NTShield.Storage</RootNamespace>
    <Description>SQLite local storage, migrations, offline queue, DPAPI secrets</Description>
    <!-- Transitive SQLitePCLRaw advisory until Microsoft.Data.Sqlite ships a fixed native pack -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NTShield.Core\NTShield.Core.csproj" />
    <ProjectReference Include="..\NTShield.Shared\NTShield.Shared.csproj" />
  </ItemGroup>
</Project>
