{
  "rules": [
    {
      "id": "INTERNAL_PASSWORD_SPRAY",
      "name": "Internal Password Spray",
      "enabled": true,
      "severity": "High",
      "category": "credential_access",
      "mitreTechnique": "T1110.003",
      "eventIds": [4625],
      "windowMinutes": 5,
      "minEventCount": 20,
      "minDistinctUsernames": 5,
      "cooldownMinutes": 15,
      "description": "Single source failed logons against many usernames on one destination within 5 minutes."
    },
    {
      "id": "DISTRIBUTED_PASSWORD_SPRAY",
      "name": "Distributed Password Spray",
      "enabled": true,
      "severity": "Critical",
      "category": "credential_access",
      "mitreTechnique": "T1110.003",
      "eventIds": [4625],
      "windowMinutes": 10,
      "minEventCount": 50,
      "minDistinctSources": 3,
      "cooldownMinutes": 15,
      "description": "Multiple sources generating high volume of failed logons against one destination."
    },
    {
      "id": "BRUTE_FORCE_SINGLE_ACCOUNT",
      "name": "Brute Force Single Account",
      "enabled": true,
      "severity": "High",
      "category": "credential_access",
      "mitreTechnique": "T1110.001",
      "eventIds": [4625],
      "windowMinutes": 5,
      "minEventCount": 20,
      "maxDistinctUsernames": 1,
      "cooldownMinutes": 10,
      "description": "Single source repeatedly failing one username on one destination."
    },
    {
      "id": "SPRAY_THEN_SUCCESS",
      "name": "Spray Then Success",
      "enabled": true,
      "severity": "Critical",
      "category": "credential_access",
      "mitreTechnique": "T1110.003",
      "type": "sequence",
      "windowMinutes": 15,
      "failureEventId": 4625,
      "successEventId": 4624,
      "minFailures": 5,
      "matchFields": ["SourceIp", "Username"],
      "cooldownMinutes": 30,
      "description": "Multiple failures followed by a successful logon for the same source/username."
    },
    {
      "id": "PRIVILEGED_LOGON_AFTER_FAILURES",
      "name": "Privileged Logon After Failures",
      "enabled": true,
      "severity": "Critical",
      "category": "privilege_escalation",
      "mitreTechnique": "T1078",
      "type": "sequence",
      "windowMinutes": 15,
      "failureEventId": 4625,
      "successEventId": 4624,
      "privilegeEventId": 4672,
      "minFailures": 3,
      "matchFields": ["SourceIp"],
      "cooldownMinutes": 30,
      "description": "Failed logons from a source followed by successful logon and special privileges (4672)."
    },
    {
      "id": "SUSPICIOUS_ACCOUNT_NAMES",
      "name": "Suspicious Account Names",
      "enabled": true,
      "severity": "Medium",
      "category": "credential_access",
      "mitreTechnique": "T1110",
      "eventIds": [4625, 4624],
      "windowMinutes": 10,
      "minEventCount": 5,
      "suspiciousUsernames": [
        "123", "admin", "admin1", "administrator", "guest", "root",
        "www", "wwwroot", "db", "web", "data", "test", "oracle", "postgres"
      ],
      "cooldownMinutes": 20,
      "description": "Suspicious account names with sufficient volume (name alone does not alert)."
    },
    {
      "id": "SUCCESSFUL_LOGON_BURST",
      "name": "Successful Logon Burst (4624)",
      "enabled": true,
      "severity": "Medium",
      "category": "credential_access",
      "mitreTechnique": "T1078",
      "type": "event_volume",
      "eventIds": [4624],
      "windowMinutes": 5,
      "minEventCount": 30,
      "cooldownMinutes": 15,
      "description": "Abnormally high volume of successful logons (4624) on one host."
    },
    {
      "id": "FAILED_LOGON_VOLUME",
      "name": "Failed Logon Volume (4625)",
      "enabled": true,
      "severity": "Medium",
      "category": "credential_access",
      "mitreTechnique": "T1110",
      "type": "event_volume",
      "eventIds": [4625],
      "windowMinutes": 5,
      "minEventCount": 40,
      "cooldownMinutes": 10,
      "description": "High volume of failed logons even if spray thresholds not fully met."
    },
    {
      "id": "NETWORK_LOGON_BURST",
      "name": "Network Logon Burst",
      "enabled": true,
      "severity": "Medium",
      "category": "lateral_movement",
      "mitreTechnique": "T1021.002",
      "eventIds": [4624],
      "logonTypes": [3],
      "windowMinutes": 10,
      "minEventCount": 15,
      "cooldownMinutes": 20,
      "description": "Burst of successful network logons (type 3)."
    },
    {
      "id": "RDP_LOGON_BURST",
      "name": "RDP Logon Burst",
      "enabled": true,
      "severity": "High",
      "category": "lateral_movement",
      "mitreTechnique": "T1021.001",
      "eventIds": [4624, 4625],
      "logonTypes": [10, 7],
      "windowMinutes": 10,
      "minEventCount": 10,
      "cooldownMinutes": 15,
      "description": "Burst of RDP-related logons (type 10/7)."
    },
    {
      "id": "EXPLICIT_CREDENTIALS_LATERAL",
      "name": "Explicit Credentials Lateral Use",
      "enabled": true,
      "severity": "High",
      "category": "lateral_movement",
      "mitreTechnique": "T1021",
      "type": "presence",
      "eventIds": [4648],
      "windowMinutes": 15,
      "minEventCount": 3,
      "cooldownMinutes": 20,
      "description": "Repeated explicit credential use (4648)."
    },
    {
      "id": "EXPLICIT_CREDENTIALS_SINGLE",
      "name": "Explicit Credentials Observed (4648)",
      "enabled": true,
      "severity": "Low",
      "category": "lateral_movement",
      "mitreTechnique": "T1021",
      "type": "presence",
      "eventIds": [4648],
      "windowMinutes": 60,
      "minEventCount": 1,
      "cooldownMinutes": 30,
      "description": "Any 4648 explicit credentials event (notable; may be noisy — tune allowlist)."
    },
    {
      "id": "SPECIAL_PRIVILEGES_ASSIGNED",
      "name": "Special Privileges Assigned (4672)",
      "enabled": true,
      "severity": "Low",
      "category": "privilege_escalation",
      "mitreTechnique": "T1078",
      "type": "presence",
      "eventIds": [4672],
      "windowMinutes": 30,
      "minEventCount": 1,
      "cooldownMinutes": 20,
      "description": "4672 special privileges assigned to new logon (often admin). Informational unless chained."
    },
    {
      "id": "PROCESS_CREATION_BURST",
      "name": "Process Creation Burst (4688)",
      "enabled": true,
      "severity": "Medium",
      "category": "execution",
      "mitreTechnique": "T1059",
      "type": "event_volume",
      "eventIds": [4688],
      "windowMinutes": 5,
      "minEventCount": 80,
      "minDistinctProcessPaths": 10,
      "cooldownMinutes": 15,
      "description": "Abnormally high process creation rate (4688) with many distinct paths."
    },
    {
      "id": "PROCESS_FROM_TEMP_PATH",
      "name": "Process From Temp/Public Path (4688)",
      "enabled": true,
      "severity": "High",
      "category": "execution",
      "mitreTechnique": "T1204",
      "type": "process_match",
      "eventIds": [4688],
      "windowMinutes": 30,
      "minEventCount": 1,
      "processPathContains": [
        "\\Temp\\",
        "\\tmp\\",
        "\\Users\\Public\\",
        "\\AppData\\Local\\Temp\\",
        "\\AppData\\Roaming\\",
        "\\Downloads\\",
        "\\Perflogs\\",
        "\\$Recycle.Bin\\"
      ],
      "cooldownMinutes": 20,
      "description": "Process created from temporary or world-writable path."
    },
    {
      "id": "LOLBINS_PROCESS_CREATION",
      "name": "LOLBins Process Creation (4688)",
      "enabled": true,
      "severity": "High",
      "category": "execution",
      "mitreTechnique": "T1218",
      "type": "process_match",
      "eventIds": [4688],
      "windowMinutes": 30,
      "minEventCount": 1,
      "processPathContains": [
        "\\powershell.exe",
        "\\pwsh.exe",
        "\\cmd.exe",
        "\\wscript.exe",
        "\\cscript.exe",
        "\\mshta.exe",
        "\\certutil.exe",
        "\\bitsadmin.exe",
        "\\rundll32.exe",
        "\\regsvr32.exe",
        "\\wmic.exe",
        "\\msiexec.exe",
        "\\installutil.exe",
        "\\cmstp.exe",
        "\\hh.exe"
      ],
      "cooldownMinutes": 15,
      "description": "Living-off-the-land binary process creation (may need allowlist for admin tools)."
    },
    {
      "id": "SUSPICIOUS_CMDLINE_TOKENS",
      "name": "Suspicious Command Line Tokens (4688)",
      "enabled": true,
      "severity": "Critical",
      "category": "execution",
      "mitreTechnique": "T1059",
      "type": "process_match",
      "eventIds": [4688],
      "windowMinutes": 60,
      "minEventCount": 1,
      "commandLineContains": [
        " -enc ",
        " -EncodedCommand",
        "FromBase64String",
        "IEX(",
        "Invoke-Expression",
        "DownloadString",
        "DownloadFile",
        "Invoke-WebRequest",
        "bypass",
        "Hidden",
        " -nop ",
        " -w hidden",
        "reg add",
        "schtasks /create",
        "net user ",
        "net localgroup administrators"
      ],
      "cooldownMinutes": 10,
      "description": "Command line contains common attack tokens (requires command-line auditing)."
    },
    {
      "id": "NEW_SERVICE_INSTALLED",
      "name": "New Service Installed",
      "enabled": true,
      "severity": "High",
      "category": "persistence",
      "mitreTechnique": "T1543.003",
      "type": "presence",
      "eventIds": [4697, 7045],
      "windowMinutes": 30,
      "minEventCount": 1,
      "cooldownMinutes": 30,
      "description": "New Windows service (4697/7045)."
    },
    {
      "id": "SCHEDULED_TASK_CREATED",
      "name": "Scheduled Task Created",
      "enabled": true,
      "severity": "High",
      "category": "persistence",
      "mitreTechnique": "T1053.005",
      "type": "presence",
      "eventIds": [4698],
      "windowMinutes": 30,
      "minEventCount": 1,
      "cooldownMinutes": 30,
      "description": "Scheduled task created (4698)."
    },
    {
      "id": "ACCOUNT_CREATED",
      "name": "User Account Created",
      "enabled": true,
      "severity": "High",
      "category": "persistence",
      "mitreTechnique": "T1136.001",
      "type": "presence",
      "eventIds": [4720],
      "windowMinutes": 60,
      "minEventCount": 1,
      "cooldownMinutes": 30,
      "description": "User account created (4720)."
    },
    {
      "id": "PRIVILEGED_GROUP_CHANGE",
      "name": "Privileged Group Membership Change",
      "enabled": true,
      "severity": "Critical",
      "category": "privilege_escalation",
      "mitreTechnique": "T1098",
      "type": "presence",
      "eventIds": [4728, 4732],
      "windowMinutes": 60,
      "minEventCount": 1,
      "cooldownMinutes": 15,
      "description": "User added to global/local security group (4728/4732)."
    },
    {
      "id": "WFP_CONNECTION_ALLOWED",
      "name": "WFP Connection Allowed Burst (5156)",
      "enabled": true,
      "severity": "Low",
      "category": "network",
      "mitreTechnique": "T1046",
      "type": "event_volume",
      "eventIds": [5156],
      "windowMinutes": 5,
      "minEventCount": 100,
      "cooldownMinutes": 20,
      "description": "High volume of Filtering Platform allowed connections (5156)."
    },
    {
      "id": "WFP_CONNECTION_BLOCKED",
      "name": "WFP Connection Blocked Burst (5157)",
      "enabled": true,
      "severity": "Medium",
      "category": "network",
      "mitreTechnique": "T1046",
      "type": "event_volume",
      "eventIds": [5157],
      "windowMinutes": 5,
      "minEventCount": 30,
      "cooldownMinutes": 15,
      "description": "High volume of Filtering Platform blocked connections (5157) — possible scan/probe."
    },
    {
      "id": "WFP_CONNECTION_TO_AUTH_PORTS",
      "name": "WFP Allowed to Auth Ports (5156)",
      "enabled": true,
      "severity": "Medium",
      "category": "lateral_movement",
      "mitreTechnique": "T1021",
      "type": "threshold",
      "eventIds": [5156],
      "destinationPorts": [22, 23, 135, 139, 445, 1433, 3306, 3389, 5985, 5986],
      "windowMinutes": 10,
      "minEventCount": 15,
      "cooldownMinutes": 15,
      "description": "Many WFP-allowed connections toward authentication/admin ports."
    },
    {
      "id": "MULTIPLE_INTERNAL_TARGETS",
      "name": "Multiple Internal Targets",
      "enabled": true,
      "severity": "High",
      "category": "lateral_movement",
      "mitreTechnique": "T1021",
      "type": "network",
      "windowMinutes": 10,
      "minDistinctDestinations": 5,
      "authPorts": [22, 23, 80, 135, 139, 443, 445, 1433, 3306, 3389, 5985, 5986],
      "cooldownMinutes": 15,
      "description": "One host connecting to many destinations on auth-related ports."
    },
    {
      "id": "IIS_W3WP_SPAWN_SHELL",
      "name": "IIS w3wp Spawns Shell (4688)",
      "enabled": true,
      "severity": "Critical",
      "category": "execution",
      "mitreTechnique": "T1505.003",
      "type": "process_match",
      "eventIds": [4688],
      "windowMinutes": 30,
      "minEventCount": 1,
      "processPathContains": [
        "\\cmd.exe",
        "\\powershell.exe",
        "\\pwsh.exe",
        "\\wscript.exe",
        "\\cscript.exe",
        "\\mshta.exe",
        "\\bash.exe",
        "\\sh.exe"
      ],
      "commandLineContains": [
        "w3wp.exe",
        "w3wp"
      ],
      "cooldownMinutes": 10,
      "description": "IIS worker process (w3wp) parent of interactive shell — classic webshell / RCE indicator. Requires process creation auditing (4688). Parent appears in event XML."
    },
    {
      "id": "IIS_WEBSHELL_CMDLINE",
      "name": "IIS Webshell Command Tokens (4688)",
      "enabled": true,
      "severity": "Critical",
      "category": "execution",
      "mitreTechnique": "T1505.003",
      "type": "process_match",
      "eventIds": [4688],
      "windowMinutes": 60,
      "minEventCount": 1,
      "processPathContains": [
        "\\w3wp.exe",
        "\\cmd.exe",
        "\\powershell.exe",
        "\\csc.exe",
        "\\cvtres.exe"
      ],
      "commandLineContains": [
        "whoami",
        "net user",
        "net localgroup",
        "FromBase64String",
        "IEX(",
        "DownloadString",
        "aspnet_compiler",
        "App_Web_",
        "\\inetpub\\",
        "\\wwwroot\\"
      ],
      "cooldownMinutes": 10,
      "description": "Process/cmdline tokens consistent with webshell or IIS-hosted payload execution under web paths."
    },
    {
      "id": "IIS_ASPNET_APP_ERRORS",
      "name": "IIS / ASP.NET Application Errors",
      "enabled": true,
      "severity": "Medium",
      "category": "availability",
      "mitreTechnique": "T1499",
      "type": "event_volume",
      "eventIds": [1309, 1310, 1325],
      "windowMinutes": 10,
      "minEventCount": 15,
      "cooldownMinutes": 20,
      "description": "Burst of ASP.NET application errors (Application log 1309/1310/1325) — exploit probe or app fault."
    },
    {
      "id": "IIS_WORKER_PROCESS_FAILURE",
      "name": "IIS / WAS Worker Process Failure",
      "enabled": true,
      "severity": "High",
      "category": "availability",
      "mitreTechnique": "T1499",
      "type": "presence",
      "eventIds": [5002, 5009, 5010, 5011, 5012, 5013, 2276, 2280, 2303],
      "windowMinutes": 30,
      "minEventCount": 1,
      "cooldownMinutes": 15,
      "description": "IIS/WAS worker process failure or rapid-fail (Application/WAS logs)."
    },
    {
      "id": "IIS_SERVICE_CRASH",
      "name": "IIS Related Service Crash (7031/7034)",
      "enabled": true,
      "severity": "High",
      "category": "availability",
      "mitreTechnique": "T1499",
      "type": "process_match",
      "eventIds": [7031, 7034],
      "windowMinutes": 60,
      "minEventCount": 1,
      "processPathContains": [
        "W3SVC",
        "WAS",
        "IISADMIN",
        "w3wp",
        "World Wide Web"
      ],
      "cooldownMinutes": 20,
      "description": "W3SVC/WAS service terminated unexpectedly (System 7031/7034)."
    },
    {
      "id": "IIS_CONFIG_CHANGE",
      "name": "IIS Configuration Change",
      "enabled": true,
      "severity": "Medium",
      "category": "persistence",
      "mitreTechnique": "T1505.003",
      "type": "presence",
      "eventIds": [29, 30, 40, 41, 50, 51, 52],
      "windowMinutes": 60,
      "minEventCount": 1,
      "cooldownMinutes": 30,
      "description": "IIS configuration operational event (Microsoft-Windows-IIS-Configuration/Operational)."
    },
    {
      "id": "IIS_W3WP_OUTBOUND_FANOUT",
      "name": "IIS w3wp Outbound Fan-out",
      "enabled": true,
      "severity": "High",
      "category": "command_and_control",
      "mitreTechnique": "T1071",
      "type": "network",
      "windowMinutes": 10,
      "minDistinctDestinations": 8,
      "processPathContains": ["w3wp"],
      "cooldownMinutes": 15,
      "description": "IIS worker (w3wp) opens many distinct outbound destinations — possible webshell C2 or SSRF abuse."
    },
    {
      "id": "IIS_WEB_PORTS_SCAN_LIKE",
      "name": "Web Ports Connection Fan-out (80/443/8080)",
      "enabled": true,
      "severity": "Medium",
      "category": "discovery",
      "mitreTechnique": "T1046",
      "type": "network",
      "windowMinutes": 10,
      "minDistinctDestinations": 15,
      "authPorts": [80, 443, 8080, 8443, 8000, 8888],
      "cooldownMinutes": 20,
      "description": "Host connects to many destinations on web ports — scan or broad web crawl from server."
    },
    {
      "id": "LATERAL_AUTH_PORT_SCAN",
      "name": "Lateral Auth Port Fan-out",
      "enabled": true,
      "severity": "High",
      "category": "discovery_lateral",
      "mitreTechnique": "T1046",
      "type": "network",
      "windowMinutes": 5,
      "minDistinctDestinations": 8,
      "authPorts": [22, 23, 135, 139, 445, 1433, 3306, 3389, 5985, 5986],
      "cooldownMinutes": 15,
      "description": "Rapid fan-out to many hosts on admin/auth ports."
    },
    {
      "id": "ALL_COLLECTED_EVENTS_DIGEST",
      "name": "Collected Events Activity Digest",
      "enabled": true,
      "severity": "Informational",
      "category": "telemetry",
      "type": "event_volume",
      "eventIds": [4624, 4625, 4648, 4672, 4688, 4697, 4698, 4720, 4728, 4732, 5156, 5157, 7045],
      "windowMinutes": 15,
      "minEventCount": 200,
      "cooldownMinutes": 30,
      "description": "Host generated high combined volume across all monitored event IDs (telemetry/anomaly baseline)."
    }
  ]
}
