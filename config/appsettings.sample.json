{
  "Agent": {
    "Name": "NT Shield Agent",
    "HeartbeatSeconds": 60,
    "CollectionIntervalSeconds": 5,
    "DetectOnly": true
  },
  "Collectors": {
    "SecurityEvents": true,
    "NetworkConnections": true,
    "Processes": true,
    "Services": true,
    "ScheduledTasks": true
  },
  "Server": {
    "Url": "https://sentinel.example.local",
    "EnrollmentToken": "<copy-from-Central-secrets.json>",
    "ApiKey": "",
    "CaCertificatePath": "C:\\ProgramData\\NTShield\\Agent\\central-ca.cer",
    "AllowUntrustedServerCertificate": false,
    "BatchSize": 200,
    "OfflineQueueLimit": 100000
  },
  "Detection": {
    "RulesPath": "config/rules.json",
    "AllowlistPath": "config/allowlist.json"
  }
}
