<Window x:Class="NTShield.Gui.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NT Shield Agent" Width="1540" Height="900" MinWidth="1250" MinHeight="720"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource BackgroundBrush}">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
  <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <!-- Sidebar -->
  <Border Grid.RowSpan="2" Grid.Column="0">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#171C26"/><GradientStop Color="#111722" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0"><Image Source="Assets/ntshield_logo_64.png" Width="38" Height="38"/><TextBlock Text="NT Shield Agent" Foreground="White" FontSize="18" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Row="1" Margin="0,8">
      <Button Style="{StaticResource SideButton}" Background="#B37A00"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Foreground="White" FontSize="20" Width="34"/><TextBlock Text="Dashboard" Foreground="White" VerticalAlignment="Center"/></StackPanel></Button>
      <Button Style="{StaticResource SideButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="⚠" Foreground="White" FontSize="20" Width="34"/><TextBlock Text="Incidents" Foreground="White" VerticalAlignment="Center"/><Border Background="#3B465A" CornerRadius="12" Padding="8,2" Margin="75,0,0,0"><TextBlock Text="7" Foreground="White"/></Border></StackPanel></Button>
      <Button Style="{StaticResource SideButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="White" FontSize="20" Width="34"/><TextBlock Text="Endpoints" Foreground="White"/></StackPanel></Button>
      <Button Style="{StaticResource SideButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="◎" Foreground="White" FontSize="20" Width="34"/><TextBlock Text="Detections" Foreground="White"/></StackPanel></Button>
      <Button Style="{StaticResource SideButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="▰" Foreground="White" FontSize="20" Width="34"/><TextBlock Text="Evidence" Foreground="White"/></StackPanel></Button>
      <Button Style="{StaticResource SideButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="ϟ" Foreground="White" FontSize="20" Width="34"/><TextBlock Text="Actions" Foreground="White"/></StackPanel></Button>
      <Button Style="{StaticResource SideButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="White" FontSize="20" Width="34"/><TextBlock Text="Rules" Foreground="White"/></StackPanel></Button>
      <Button Style="{StaticResource SideButton}"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Foreground="White" FontSize="20" Width="34"/><TextBlock Text="Settings" Foreground="White"/></StackPanel></Button>
    </StackPanel>
    <Border Grid.Row="2" Background="#252D3B" CornerRadius="10" Margin="14" Padding="14"><StackPanel><TextBlock Text="🛡  Agent Status" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Healthy" Foreground="#35D880" FontSize="16" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="Last check-in: 2 min ago" Foreground="#D8E4F7" Margin="0,5,0,0"/><TextBlock Text="Version 1.0.0" Foreground="#8298B8" Margin="0,14,0,0"/></StackPanel></Border>
   </Grid>
  </Border>

  <!-- Header -->
  <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="0" Background="White" BorderBrush="#E4EAF3" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_MouseLeftButtonDown">
   <Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="🛡" FontSize="26"/><StackPanel Margin="10,0"><TextBlock Text="Protected" FontWeight="Bold" FontSize="16"/><TextBlock Text="All systems operational" Foreground="#73809A" FontSize="12"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="🔔 3" Background="Transparent" BorderThickness="0" Padding="10"/><Button Content="?" Background="Transparent" BorderThickness="0" Padding="10"/><Button Content="—" Click="Minimize_Click" Background="Transparent" BorderThickness="0" Padding="12"/><Button Content="□" Click="Maximize_Click" Background="Transparent" BorderThickness="0" Padding="12"/><Button Content="×" Click="Close_Click" Background="Transparent" BorderThickness="0" Padding="12"/></StackPanel>
   </Grid>
  </Border>

  <!-- Main content -->
  <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="16,14,10,16">
    <DockPanel Margin="6,0,6,8"><TextBlock Text="Threat Overview" FontWeight="Bold" FontSize="19"/><ComboBox DockPanel.Dock="Right" Width="130" SelectedIndex="0"><ComboBoxItem Content="Last 24 hours"/><ComboBoxItem Content="Last 7 days"/></ComboBox></DockPanel>
    <UniformGrid Columns="4">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Active Incidents"/><TextBlock Text="7" Foreground="#F04444" FontSize="27" FontWeight="Bold"/><TextBlock Text="↑ 40% vs yesterday" Foreground="#F04444" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Detections"/><TextBlock Text="132" Foreground="#B37A00" FontSize="27" FontWeight="Bold"/><TextBlock Text="↓ 12% vs yesterday" Foreground="#18B86B" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="At Risk Endpoints"/><TextBlock Text="3" Foreground="#FF9F1A" FontSize="27" FontWeight="Bold"/><TextBlock Text="↑ 25% vs yesterday" Foreground="#FF9F1A" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Protected Endpoints"/><TextBlock Text="245" Foreground="#18B86B" FontSize="27" FontWeight="Bold"/><TextBlock Text="↑ 8% vs yesterday" Foreground="#18B86B" FontSize="11"/></StackPanel></Border>
    </UniformGrid>

    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Active Incidents" FontWeight="Bold" FontSize="15"/><TextBlock Text="View all" Foreground="#B37A00" DockPanel.Dock="Right"/></DockPanel><Separator Margin="0,10"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition/><ColumnDefinition Width="110"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="35"/><RowDefinition Height="35"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#F04444" CornerRadius="4" Padding="7,3" Margin="0,5,12,5"><TextBlock Text="High" Foreground="White"/></Border><TextBlock Grid.Row="0" Grid.Column="1" Text="Password Spray (Internal)" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="2" Text="10.0.105.35 → .190" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Row="0" Grid.Column="3" Text="2 min" FontSize="11" VerticalAlignment="Center"/>
        <Border Grid.Row="1" Background="#F04444" CornerRadius="4" Padding="7,3" Margin="0,5,12,5"><TextBlock Text="High" Foreground="White"/></Border><TextBlock Grid.Row="1" Grid.Column="1" Text="Multiple Failed Logins" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="2" Text="10.0.104.22 → .11" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Grid.Column="3" Text="15 min" FontSize="11" VerticalAlignment="Center"/>
        <Border Grid.Row="2" Background="#FF9F1A" CornerRadius="4" Padding="7,3" Margin="0,5,12,5"><TextBlock Text="Medium" Foreground="White"/></Border><TextBlock Grid.Row="2" Grid.Column="1" Text="Suspicious Service Execution" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="2" Text="10.0.102.17 → .8" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Row="2" Grid.Column="3" Text="32 min" FontSize="11" VerticalAlignment="Center"/>
        <Border Grid.Row="3" Background="#FFE9BB" CornerRadius="4" Padding="7,3" Margin="0,5,12,5"><TextBlock Text="Low" Foreground="#A86B00"/></Border><TextBlock Grid.Row="3" Grid.Column="1" Text="Anomalous Process Activity" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="2" Text="10.0.103.45 → .9" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Row="3" Grid.Column="3" Text="1 hr" FontSize="11" VerticalAlignment="Center"/>
        <Border Grid.Row="4" Background="#FFE9BB" CornerRadius="4" Padding="7,3" Margin="0,5,12,5"><TextBlock Text="Low" Foreground="#A86B00"/></Border><TextBlock Grid.Row="4" Grid.Column="1" Text="Policy Change Detected" VerticalAlignment="Center"/><TextBlock Grid.Row="4" Grid.Column="2" Text="10.0.101.77" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Row="4" Grid.Column="3" Text="2 hr" FontSize="11" VerticalAlignment="Center"/>
       </Grid></StackPanel></Border>
      <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Failed Login Spikes" FontWeight="Bold" FontSize="15"/><TextBlock Text="Last 24 hours" Foreground="#6C7892" DockPanel.Dock="Right"/></DockPanel><Canvas Height="190" Margin="10,15,10,0"><Line X1="45" Y1="10" X2="45" Y2="160" Stroke="#D8E3F0"/><Line X1="45" Y1="160" X2="430" Y2="160" Stroke="#D8E3F0"/><Polyline Stroke="#B37A00" StrokeThickness="3" Points="45,142 75,125 105,112 135,95 165,101 195,73 225,66 255,92 285,102 315,84 345,112 375,77 405,55 430,62"/><Polygon Fill="#22FFC400" Points="45,142 75,125 105,112 135,95 165,101 195,73 225,66 255,92 285,102 315,84 345,112 375,77 405,55 430,62 430,160 45,160"/><Border Canvas.Left="400" Canvas.Top="30" Background="#B37A00" CornerRadius="5" Padding="7,3"><TextBlock Text="880" Foreground="White"/></Border></Canvas></StackPanel></Border>
    </Grid>

    <UniformGrid Columns="4">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Password Spray Detection" FontWeight="Bold"/><Grid Height="130"><Ellipse Width="92" Height="92" Stroke="#F04444" StrokeThickness="13"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="11" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Users" FontSize="11"/></StackPanel></Grid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Top Source IPs" FontWeight="Bold"/><TextBlock Text="10.0.105.35    ━━━━━━━  880" Margin="0,20,0,5"/><TextBlock Text="10.0.104.22    ━━━      120"/><TextBlock Text="10.0.103.45    ━        67"/><TextBlock Text="10.0.101.77    ━        31"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Top Destination Hosts" FontWeight="Bold"/><TextBlock Text="10.0.105.190   ━━━━━━━  880" Margin="0,20,0,5"/><TextBlock Text="10.0.104.11    ━━━      120"/><TextBlock Text="10.0.102.8     ━        67"/><TextBlock Text="10.0.103.9     ━        31"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Process / Service Correlation" FontWeight="Bold"/><Grid Height="130"><Ellipse Width="92" Height="92" Stroke="#B37A00" StrokeThickness="13"/><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="132" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="Events" FontSize="11"/></StackPanel></Grid></StackPanel></Border>
    </UniformGrid>

    <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Recent Response Actions" FontWeight="Bold" FontSize="15"/><TextBlock Text="View all actions" Foreground="#B37A00" DockPanel.Dock="Right"/></DockPanel><DataGrid ItemsSource="{Binding}" Margin="0,10,0,0" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal"><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180"/><DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="150"/><DataGridTextColumn Header="Triggered By" Binding="{Binding TriggeredBy}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></Border>
   </StackPanel>
  </ScrollViewer>

  <!-- Right rail -->
  <ScrollViewer Grid.Column="2" Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#F7F9FD"><StackPanel Margin="8,8,14,16">
   <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid Height="315"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition/></Grid.RowDefinitions><Border Background="#B37A00"><DockPanel Margin="14,0"><TextBlock Text="NT Shield AI Analyst" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="—   ×" Foreground="White" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel></Border><Grid Grid.Row="1" Background="#FFF9E8"><Border Background="White" BorderBrush="#DCE5F2" BorderThickness="1" CornerRadius="8" Padding="12" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Width="200"><TextBlock Text="I am the NT Shield AI Analyst.&#10;ฉันช่วยเฝ้าระวัง วิเคราะห์ และตอบสนอง Incident ได้" TextWrapping="Wrap" FontSize="12"/></Border><Image Source="Assets/ntshield_full.png" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="255" Margin="0,0,-12,-5"/></Grid></Grid></Border>
   <Border Style="{StaticResource Card}"><StackPanel><DockPanel><TextBlock Text="Incident Detail" FontWeight="Bold" FontSize="16"/><Border Background="#F04444" CornerRadius="5" Padding="9,3" DockPanel.Dock="Right"><TextBlock Text="High" Foreground="White"/></Border></DockPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/><RowDefinition Height="26"/></Grid.RowDefinitions><TextBlock Text="Incident"/><TextBlock Grid.Column="1" Text="Password Spray (Internal)" FontWeight="SemiBold"/><TextBlock Grid.Row="1" Text="Source IP"/><TextBlock Grid.Row="1" Grid.Column="1" Text="10.0.105.35"/><TextBlock Grid.Row="2" Text="Destination IP"/><TextBlock Grid.Row="2" Grid.Column="1" Text="10.0.105.190"/><TextBlock Grid.Row="3" Text="Process"/><TextBlock Grid.Row="3" Grid.Column="1" Text="svchost.exe"/><TextBlock Grid.Row="4" Text="Service"/><TextBlock Grid.Row="4" Grid.Column="1" Text="IPTVManagementService"/><TextBlock Grid.Row="5" Text="Logon Type"/><TextBlock Grid.Row="5" Grid.Column="1" Text="8 (NetworkCleartext)"/><TextBlock Grid.Row="6" Text="Failed Attempts"/><TextBlock Grid.Row="6" Grid.Column="1" Text="880"/><TextBlock Grid.Row="7" Text="Successful Login"/><TextBlock Grid.Row="7" Grid.Column="1" Text="False"/></Grid></StackPanel></Border>
   <UniformGrid Columns="2"><Button Style="{StaticResource PrimaryButton}" Content="⊘  Block Destination" Click="Action_Click"/><Button Style="{StaticResource PrimaryButton}" Content="⌁  Capture Evidence" Click="Action_Click"/><Button Style="{StaticResource OutlineButton}" Content="🛡  Quarantine Host" Click="Action_Click"/><Button Style="{StaticResource OutlineButton}" Content="⇩  Export Report" Click="Action_Click"/></UniformGrid>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>